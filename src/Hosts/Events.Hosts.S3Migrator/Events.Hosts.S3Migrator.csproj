        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-Events.Hosts.S3Migrator-1b06939c-0fe1-4f6f-8987-301a12193242</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.18.7"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Application\Events.Application.Services\Events.Application.Services.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\Application\Events.Application.Services\Features\Files\Placeholders\EventsPreviews\*.*">
